COMMENTS_HOST=127.0.0.1
COMMENTS_PORT=4317
COMMENTS_DB=/path/to/comments.sqlite3
# 多个正式域名用逗号分隔；第一个是规范 Origin（CQNB 会话校验使用）
COMMENTS_PUBLIC_ORIGIN=https://example.com,https://writing.example.com
COMMENTS_HMAC_SECRET=YOUR_VALUE_HERE
COMMENTS_STATIC_DIR=/path/to/site
# 身份策略（public 平台默认 disabled = 匿名投稿→pending）
# disabled | cqnb
COMMENTS_IDENTITY_MODE=disabled
COMMENTS_CQNB_SESSION_URL=http://127.0.0.1:3000/api/auth/session
# cqnb 模式下：登录必填 → 未登录 401；已登录评论按 AUTO_APPROVE 公开
COMMENTS_REQUIRE_LOGIN=false
COMMENTS_AUTO_APPROVE=false
