{{- $published := where .Site.RegularPages "Draft" false -}}
{{- $safeDescription := .Site.Params.siteDescription -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Params.siteName }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $safeDescription }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>zh-cn</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml"/>
    {{- range $published }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>
        {{- $metaOnly := or (eq .Params.rightsMode "excerpt") (eq .Params.rightsMode "link-only") -}}
        {{- $text := or .Description .Params.qqSummary -}}
        {{- if and (not $text) (not $metaOnly) }}{{ $text = .Summary }}{{ end -}}
        {{- $text | htmlEscape -}}
      </description>
    </item>
    {{- end }}
  </channel>
</rss>
